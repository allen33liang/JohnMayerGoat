	$(MAKE) $(MAKESILENT) -f CMakeFiles/JohnMayerGoat.dir/build.make CMakeFiles/JohnMayerGoat.dir/src/presets/PresetManager.cpp.i
.PHONY : src/presets/PresetManager.cpp.i

src/presets/PresetManager.s: src/presets/PresetManager.cpp.s
.PHONY : src/presets/PresetManager.s

# target to generate assembly for a file
src/presets/PresetManager.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/JohnMayerGoat.dir/build.make CMakeFiles/JohnMayerGoat.dir/src/presets/PresetManager.cpp.s
.PHONY : src/presets/PresetManager.cpp.s

